# Copy this file to .env and adjust as needed.
# These DB_* values must match docker-compose.yml.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=speak
DB_USER=speak_app
DB_PASSWORD=speak
DB_ROOT_PASSWORD=speak

JWT_SECRET=change-this-to-a-long-random-string

PORT=3000

# Base URL of the frontend, used to build links sent to users (e.g. the
# teacher password-reset link). Point this at wherever the React app is
# actually served from.
FRONTEND_URL=http://localhost:5173
